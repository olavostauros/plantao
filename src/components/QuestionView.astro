---
// Uma questão completa: legível sem JS (enunciado, texto-base, alternativas, gabarito, fonte).
// Só a ilha de responder leva JS.
import { AnswerForm, label } from './AnswerForm';
import { renderMarkdown, splitCommand } from '../lib/markdown';
import type { Question } from '../lib/snapshot';

interface Props {
  question: Question;
  prev?: Question;
  next?: Question;
}

const { question: q, prev, next } = Astro.props;
const base = import.meta.env.BASE_URL;
const md = (src: string) => renderMarkdown(src, { assets: q.assets, base });

const { command, item } =
  q.type === 'true_false' ? splitCommand(q.statement_md) : { command: null, item: q.statement_md };
const choices = q.options.map((o) => ({ letter: o.letter, html: md(o.body_md) }));
const formType = q.type === 'essay' ? null : q.type;
const page = `${base}questao/`;
const appliedOn = q.applied_on
  ? new Date(`${q.applied_on}T12:00:00`).toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;
---

<article aria-labelledby="titulo">
  <p class="m-0 text-base text-muted">
    {q.exam_board_short_name} · {q.agency_short_name} · {q.year} · {q.subject_name}
  </p>
  <h1 id="titulo" class="mt-1 mb-4 text-2xl font-bold">
    Questão {q.number} <span class="block text-lg font-normal text-muted">{q.exam_name}</span>
  </h1>

  {
    q.answer_status === 'annulled' && (
      <p class="mb-4 rounded-lg border-2 border-bad px-3 py-2 font-semibold">Questão anulada pela banca.</p>
    )
  }

  {
    q.passage_md && (
      <section aria-labelledby="texto-base" class="mb-6 rounded-lg bg-surface p-4">
        <h2 id="texto-base" class="mt-0 mb-2 text-base font-semibold text-muted">
          Texto-base
        </h2>
        <div class="md" set:html={md(q.passage_md)} />
      </section>
    )
  }

  <section aria-label="Enunciado" class="mb-6">
    {command && <div class="md mb-3 text-muted" set:html={md(command)} />}
    <div class="md" set:html={md(item)} />
  </section>

  {
    formType ? (
      <AnswerForm
        client:load
        id={q.id}
        type={formType}
        choices={choices}
        answer={q.answer}
        answerPreliminary={q.answer_preliminary}
        answerStatus={q.answer_status}
      />
    ) : (
      <p class="text-muted">Questão discursiva: não tem gabarito de alternativas.</p>
    )
  }

  {
    formType && (
      <details class="mt-6 rounded-lg border-2 border-line">
        <summary class="flex min-h-11 cursor-pointer items-center px-3 font-semibold">Ver gabarito</summary>
        <div class="px-3 pb-3">
          {q.answer_status === 'annulled' ? (
            <p class="m-0">
              Anulada: nenhuma resposta conta.
              {q.answer_preliminary && <> O gabarito preliminar era {label(formType, q.answer_preliminary)}.</>}
            </p>
          ) : (
            <p class="m-0">
              Gabarito definitivo: <strong>{label(formType, q.answer!)}</strong>.
              {q.answer_status === 'changed' && q.answer_preliminary && (
                <> Alterado depois dos recursos; o preliminar era {label(formType, q.answer_preliminary)}.</>
              )}
            </p>
          )}
        </div>
      </details>
    )
  }

  <section aria-labelledby="fonte" class="mt-8 border-t border-line pt-4 text-base">
    <h2 id="fonte" class="mt-0 mb-2 text-base font-semibold">Fonte oficial</h2>
    <p class="m-0">
      {q.contest_name}. {q.exam_name}{appliedOn && <>, aplicada em {appliedOn}</>}. {q.exam_board_name}.
    </p>
    <p class="mt-1 mb-0">
      Questão {q.number}, página {q.source_page} do caderno.
      {q.source_url && (
        <>
          {' '}
          <a href={q.source_url} class="text-fg underline">
            Abrir a prova em PDF<span class="sr-only"> (site da banca)</span>
          </a>
        </>
      )}
    </p>
    {
      q.topics.length > 0 && (
        <p class="mt-2 mb-0 text-muted">Assunto: {q.topics.map((t) => t.name).join('; ')}</p>
      )
    }
  </section>

  {
    (prev || next) && (
      <nav aria-label="Outras questões desta prova" class="mt-8 flex flex-wrap justify-between gap-3">
        {prev ? (
          <a href={`${page}${prev.id}/`} rel="prev" class="inline-flex min-h-11 items-center font-semibold text-fg underline">
            ← Questão {prev.number}
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a href={`${page}${next.id}/`} rel="next" class="inline-flex min-h-11 items-center font-semibold text-fg underline">
            Questão {next.number} →
          </a>
        )}
      </nav>
    )
  }
</article>
