---
// Busca com filtros e facetas (marco F2). O HTML do build já traz as primeiras questões e as
// contagens sem filtro; sem JS, a lista continua navegável. Estado na URL (src/lib/search/url.ts).
import Base from '../../layouts/Base.astro';
import { SearchApp } from '../../components/search/SearchApp';
import { resultItem } from '../../lib/search/results';
import { siteEngine, siteSearch } from '../../lib/search/site';

const PAGE_SIZE = 20;
const base = import.meta.env.BASE_URL;
const { base: index, blocks } = siteSearch();
const engine = siteEngine();
const ords = engine.search({});
const size = index.block_size;
const initial = {
  total: ords.length,
  items: ords.slice(0, PAGE_SIZE).map((o) => resultItem(engine, o, blocks[Math.floor(o / size)][o % size])),
  facets: engine.facets({}),
};
---

<Base
  title="Questões — busca por banca, órgão, ano e assunto — Plantão"
  description="Busque questões de provas oficiais de concursos policiais por texto, banca, órgão, cargo, ano, disciplina e assunto."
>
  <h1 class="mt-0 mb-4 text-3xl font-bold">Questões</h1>
  {/* Com filtros na URL, a lista do build (sem filtros) fica invisível, mas ocupando o lugar, até a
      busca terminar: evita mostrar resultados errados e deslocar a página. */}
  <style is:inline>
    .busca-url #lista {
      visibility: hidden;
    }
  </style>
  <script is:inline>
    if (location.search.length > 1) document.documentElement.classList.add('busca-url');
  </script>
  <noscript>
    <style is:inline>
      #busca-form,
      [data-js-only] {
        display: none;
      }
    </style>
    <p class="mb-4 rounded-lg bg-surface p-3">
      A busca e os filtros precisam de JavaScript. Sem ele, abra as questões mais recentes abaixo ou veja todas as
      provas na <a href={base} class="text-fg underline">página inicial</a>.
    </p>
  </noscript>
  <SearchApp client:load base={base} version={index.version} pageSize={PAGE_SIZE} initial={initial} />
</Base>
