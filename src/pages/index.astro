---
// Página provisória: prova que o pipeline snapshot → build → GitHub Pages funciona.
// O agente de front-end substitui esta página pelo produto (docs/SPECIFICATION.md §6).
import '../styles/global.css';
import { countBy, exams, meta, questions } from '../lib/snapshot';

const byBoard = countBy(questions, (q) => q.exam_board_short_name);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Plantão — questões de concursos policiais</title>
    <meta
      name="description"
      content="Questões de provas oficiais de concursos policiais, por banca, órgão, cargo, ano e assunto."
    />
  </head>
  <body class="m-0 bg-bg font-sans text-lg/relaxed text-fg">
    <main class="mx-auto max-w-2xl px-4 py-8">
      <h1 class="text-3xl font-bold">Plantão</h1>
      <p>Questões de provas oficiais de concursos policiais. Em construção.</p>
      {meta.scope === 'seed' && (
        <p class="text-muted">Por enquanto, só questões de exemplo (fictícias).</p>
      )}
      <p>
        <strong>{questions.length}</strong> questões de <strong>{exams.length}</strong> provas.
      </p>
      <ul class="list-disc pl-6">
        {byBoard.map((b) => (
          <li>{b.value}: {b.count}</li>
        ))}
      </ul>
    </main>
  </body>
</html>

